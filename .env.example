# Copy to .env and fill in:   cp .env.example .env
# .env stays on your laptop: git ignores it. Never paste these values into a prompt.
# server.py (level 3) and agent.py (level 4) read it from here, whatever folder they run in.

# MotherDuck access token, for levels 3 and 4.
# app.motherduck.com, Settings, Integrations, Access tokens.
MOTHERDUCK_TOKEN=

# Your workshop key from the minter (or any OpenRouter key), for level 4.
# https://motherduck.com/minter/w/next-data-stack-has-no-ui/
OPENROUTER_API_KEY=

# The level 4 model. The workshop key allows openai/gpt-6-luna,
# anthropic/claude-haiku-5.5 and anthropic/claude-sonnet-5.5.
MODEL=openai/gpt-6-luna
